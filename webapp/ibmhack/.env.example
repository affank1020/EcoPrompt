# FastAPI base URL, server-side only; uses /analyse and /compress.
# Unset enables explicitly labelled local mock estimates/compression.
# Configured backend failures are surfaced, never silently replaced by mocks.
BACKEND_API_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SITE_URL=http://localhost:3000
